        "title": "eBug:PRP265603-0023 PMO 8.22 - AI Product Background(AIPC): Flash Processing UI if clicking Generate with AIPC CTA again during downloading modules",
        "head_sha": "3e45359e1514fc2cb7aeae0184e4bf81793fa5d7",
        "base_ref": "main",
        "run_url": "https://github.com/CyberLink-Team/promeo-pc-promeo/actions/runs/30923049379",
        "generated_at": "2026-08-04T15:27:56Z",
        "outcome": "pass",
        "failed_step": null,
